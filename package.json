{
  "name": "clippulse",
  "version": "1.0.0",
  "private": true,
  "description": "Contactless biometric OBS overlay and deterministic VOD auto-clipper powered by Presage SmartSpectra.",
  "main": "src/main.js",
  "type": "commonjs",
  "scripts": {
    "build": "node scripts/build.js",
    "start": "npm run build && node scripts/start.js",
    "dev": "npm run build && node scripts/start.js --dev",
    "test": "node --test test/*.test.js",
    "check:vocab": "node scripts/check-vocabulary.js",
    "generate:demo": "node scripts/generate-demo-assets.js",
    "render:highlights": "node scripts/render-highlights.js",
    "verify:nle": "node scripts/verify-nle.js"
  },
  "keywords": [
    "obs",
    "overlay",
    "smartspectra",
    "electron",
    "clipper",
    "creator-tools"
  ],
  "author": "",
  "license": "MIT",
  "engines": {
    "node": ">=20.0.0"
  },
  "dependencies": {
    "@smartspectra/node-sdk": "^3.5.0",
    "dotenv": "^18.0.10",
    "obs-websocket-js": "^5.0.8",
    "ws": "^8.23.0"
  },
  "devDependencies": {
    "electron": "^45.4.1",
    "esbuild": "^0.28.2"
  }
}
