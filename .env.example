# Copy this file to `.env` and fill in your own values.
# `.env` is gitignored and must never be committed.

# Required for LIVE mode. Get a key at https://physiology.presagetech.com/auth/login
SMARTSPECTRA_API_KEY=

# Optional. Only needed if OBS WebSocket authentication is enabled.
OBS_WS_PASSWORD=

# Optional. Defaults to ws://127.0.0.1:4455
OBS_WS_URL=ws://127.0.0.1:4455
